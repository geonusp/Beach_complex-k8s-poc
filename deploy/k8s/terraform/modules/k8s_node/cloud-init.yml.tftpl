#cloud-config

# kubeadm은 노드 이름으로 hostname을 사용한다. EC2 기본 hostname은 private IP에서
# 파생되므로(ip-10-0-1-23) 클러스터를 재생성하면 노드 이름까지 바뀐다. 재현성을 위해 고정한다.
hostname: ${node_hostname}
preserve_hostname: false
manage_etc_hosts: true

package_update: true
package_upgrade: false

packages:
  - apt-transport-https
  - ca-certificates
  - containerd
  - curl
  - gpg

write_files:
  - path: /etc/modules-load.d/kubernetes.conf
    owner: root:root
    permissions: "0644"
    content: |
      overlay
      br_netfilter

  - path: /etc/sysctl.d/99-kubernetes-cri.conf
    owner: root:root
    permissions: "0644"
    content: |
      net.bridge.bridge-nf-call-iptables  = 1
      net.bridge.bridge-nf-call-ip6tables = 1
      net.ipv4.ip_forward                 = 1

  - path: /etc/crictl.yaml
    owner: root:root
    permissions: "0644"
    content: |
      runtime-endpoint: unix:///run/containerd/containerd.sock
      image-endpoint: unix:///run/containerd/containerd.sock
      timeout: 10

  - path: /usr/local/sbin/bootstrap-k8s-node
    owner: root:root
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -Eeuo pipefail

      readonly kubernetes_version="$1"

      log() {
        printf '[beach-k8s] %s\n' "$*"
      }

      fail() {
        log "ERROR: $*"
        exit 1
      }

      # kubelet은 기본 설정에서 swap이 켜져 있으면 기동을 거부한다.
      swapoff --all
      sed -i.bak -E 's|^([^#].*\sswap\s)|#\1|' /etc/fstab

      modprobe overlay
      modprobe br_netfilter
      sysctl --system >/dev/null

      # containerd의 cgroup driver를 systemd로 맞춘다. kubelet 기본값과 어긋나면
      # kubeadm init이 실패하는데, 증상이 cgroup을 가리키지 않아 추적이 오래 걸린다.
      # 배포판 기본 config.toml은 최소 설정이라 config default로 전체를 생성한 뒤 치환한다.
      install -d -m 0755 /etc/containerd
      containerd config default > /etc/containerd/config.toml
      sed -i 's/SystemdCgroup = false/SystemdCgroup = true/' /etc/containerd/config.toml
      grep -q 'SystemdCgroup = true' /etc/containerd/config.toml \
        || fail "containerd SystemdCgroup could not be enabled"

      systemctl restart containerd
      systemctl enable --now containerd
      systemctl is-active --quiet containerd || fail "containerd is not active"

      # 커뮤니티 저장소를 사용한다. 구 apt.kubernetes.io는 폐지되었다.
      install -d -m 0755 /etc/apt/keyrings
      curl -fsSL "https://pkgs.k8s.io/core:/stable:/$${kubernetes_version}/deb/Release.key" \
        | gpg --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg
      chmod 0644 /etc/apt/keyrings/kubernetes-apt-keyring.gpg
      printf 'deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/%s/deb/ /\n' \
        "$${kubernetes_version}" > /etc/apt/sources.list.d/kubernetes.list

      apt-get -o DPkg::Lock::Timeout=300 update
      apt-get -o DPkg::Lock::Timeout=300 install --yes kubelet kubeadm kubectl

      # 무인 보안 업데이트가 kubelet을 올리면 control plane과 버전이 어긋나 노드가 이탈한다.
      apt-mark hold kubelet kubeadm kubectl

      kubeadm version
      log "bootstrap completed for $(hostnamectl --static)"

runcmd:
  - ["/usr/local/sbin/bootstrap-k8s-node", "${kubernetes_version}"]
